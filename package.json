{
  "name": "netlogo-browser-lab",
  "version": "0.1.0",
  "description": "Run and understand NetLogo models in the browser without installing Java.",
  "private": false,
  "homepage": "https://baditaflorin.github.io/netlogo-browser-lab/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "playwright test",
    "pages:publish": "gh-pages -d dist -b gh-pages"
  },
  "keywords": [],
  "author": "Florin Badita-Nistor",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@vitejs/plugin-react": "^6.0.1",
    "comlink": "^4.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
